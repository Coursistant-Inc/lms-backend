<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coursistant.lms.mapper.user.UserMapper">

    <sql id="Base_Column_List">
        id,username,password,name,phone,email,avatar,role,level,invitation
    </sql>

    <select id="selectAll" resultType="com.coursistant.lms.entity.User">
        select
        <include refid="Base_Column_List" />
        from User
        <where>
            <if test="id != null"> and id= #{id}</if>
            <if test="username != null"> and username = #{username}</if>
            <if test="password != null"> and password= #{password}</if>
            <if test="name != null"> and name= #{name}</if>
            <if test="phone != null"> and phone= #{phone}</if>
            <if test="email != null"> and email= #{email}</if>
            <if test="avatar != null"> and avatar= #{avatar}</if>
            <if test="role != null"> and role= #{role}</if>
            <if test="level != null"> and level= #{level}</if>
            <if test="invitation != null"> and invitation = #{invitation}</if>

        </where>
    </select>

    <select id="selectById" resultType="com.coursistant.lms.entity.User">
        select
        <include refid="Base_Column_List" />
        from User
        where id = #{id}
    </select>

    <select id="selectStudentsByCourseId" resultType="com.coursistant.lms.entity.User">
        select
        <include refid="Base_Column_List" />
        from User
        where id in (
            select user_id from Learn where course_id = #{courseId}
        )
    </select>

    <select id="selectUsersByIds" resultType="com.coursistant.lms.entity.User">
        SELECT * FROM User
        WHERE id IN
        <foreach item="id" collection="userIds" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <delete id="deleteById">
        delete from User
        where  id = #{id}
    </delete>

    <insert id="insert" parameterType="com.coursistant.lms.entity.User" useGeneratedKeys="true">
        insert into User
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="username != null">username,</if>
            <if test="password != null">password,</if>
            <if test="name != null">name,</if>
            <if test="phone != null">phone,</if>
            <if test="email != null">email,</if>
            <if test="avatar != null">avatar,</if>
            <if test="role != null">role,</if>
            <if test="level != null">level,</if>
            <if test="invitation != null">invitation,</if>

        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="username != null">#{username},</if>
            <if test="password != null">#{password},</if>
            <if test="name != null">#{name},</if>
            <if test="phone != null">#{phone},</if>
            <if test="email != null">#{email},</if>
            <if test="avatar != null">#{avatar},</if>
            <if test="role != null">#{role},</if>
            <if test="level != null">#{level},</if>
            <if test="invitation != null">#{invitation},</if>

        </trim>
    </insert>

    <update id="updateById" parameterType="com.coursistant.lms.entity.User">
        update User
        <set>
            <if test="username != null">
                username = #{username},
            </if>
            <if test="password != null">
                password = #{password},
            </if>
            <if test="name != null">
                name = #{name},
            </if>
            <if test="phone != null">
                phone = #{phone},
            </if>
            <if test="email != null">
                email = #{email},
            </if>
            <if test="avatar != null">
                avatar = #{avatar},
            </if>
            <if test="role != null">
                role = #{role},
            </if>
            <if test="level != null">
                level = #{level},
            </if>
            <if test="invitation != null">
                invitation = #{invitation},
            </if>

        </set>
        where id = #{id}
    </update>

    <update id="updateMustChangePassword" parameterType="com.coursistant.lms.entity.User">
        UPDATE User
        SET must_change_password = #{mustChangePassword}
        WHERE id = #{id}
    </update>

</mapper>