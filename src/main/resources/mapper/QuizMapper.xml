<mapper namespace="com.coursistant.lms.mapper.quiz.QuizMapper">

    <sql id="Base_Column_List">
        id, course_id, title, description, time_limit_minutes, attempts_allowed,
        grading_policy, start_at, due_at, publish_state, updated_at
    </sql>

    <select id="selectAll" resultType="com.coursistant.lms.entity.Quiz">
        select
        <include refid="Base_Column_List"/>
        from Quiz
        <where>
            <if test="id != null">and id = #{id}</if>
            <if test="courseId != null">and course_id = #{courseId}</if>
            <if test="title != null">and title = #{title}</if>
            <if test="description != null">and description = #{description}</if>
