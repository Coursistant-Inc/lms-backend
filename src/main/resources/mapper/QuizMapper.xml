            <if test="dueAt != null">and due_at = #{dueAt}</if>
            <if test="publishState != null">and publish_state = #{publishState}</if>
            <if test="updatedAt != null">and updated_at = #{updatedAt}</if>
        </where>
    </select>

    <select id="selectById" resultType="com.coursistant.lms.entity.Quiz">
        select
        <include refid="Base_Column_List"/>
        from Quiz
        where id = #{id}
    </select>

    <delete id="deleteById">
        delete from Quiz where id = #{id}
    </delete>

    <insert id="insert" parameterType="com.coursistant.lms.entity.Quiz" useGeneratedKeys="true" keyProperty="id">
        insert into Quiz
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="courseId != null">course_id,</if>
            <if test="title != null">title,</if>
            <if test="description != null">description,</if>
            <if test="timeLimitMinutes != null">time_limit_minutes,</if>
            <if test="attemptsAllowed != null">attempts_allowed,</if>
            <if test="gradingPolicy != null">grading_policy,</if>
            <if test="startAt != null">start_at,</if>
            <if test="dueAt != null">due_at,</if>
            <if test="publishState != null">publish_state,</if>
            <if test="updatedAt != null">updated_at,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="courseId != null">#{courseId},</if>
            <if test="title != null">#{title},</if>
            <if test="description != null">#{description},</if>
            <if test="timeLimitMinutes != null">#{timeLimitMinutes},</if>
            <if test="attemptsAllowed != null">#{attemptsAllowed},</if>
            <if test="gradingPolicy != null">#{gradingPolicy},</if>
            <if test="startAt != null">#{startAt},</if>
            <if test="dueAt != null">#{dueAt},</if>
            <if test="publishState != null">#{publishState},</if>
            <if test="updatedAt != null">#{updatedAt},</if>
        </trim>
    </insert>

    <update id="updateById" parameterType="com.coursistant.lms.entity.Quiz">
        update Quiz
        <set>
            <if test="courseId != null">course_id = #{courseId},</if>
            <if test="title != null">title = #{title},</if>
            <if test="description != null">description = #{description},</if>
            <if test="timeLimitMinutes != null">time_limit_minutes = #{timeLimitMinutes},</if>
            <if test="attemptsAllowed != null">attempts_allowed = #{attemptsAllowed},</if>
            <if test="gradingPolicy != null">grading_policy = #{gradingPolicy},</if>
            <if test="startAt != null">start_at = #{startAt},</if>
            <if test="dueAt != null">due_at = #{dueAt},</if>
