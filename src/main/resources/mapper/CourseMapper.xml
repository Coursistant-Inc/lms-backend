<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coursistant.individual.mapper.course.CourseMapper">

    <sql id="Base_Column_List">
        id,name,course_code,teacher_id,semester,instructor_name,school
    </sql>

    <select id="selectAll" resultType="com.coursistant.individual.entity.Course">
        select Course.*, User.name as teacherName, User.phone as teacherPhone, User.email as teacherEmail
        from Course
        left join User on Course.teacher_id = User.id
        <where>
            <if test="id != null"> and id= #{id}</if>
            <if test="name != null"> and Course.name like concat('%', #{name}, '%')</if>
            <if test="courseCode != null"> and course_code= #{courseCode}</if>
            <if test="teacherId != null"> and teacher_id= #{teacherId}</if>
            <if test="instructorName != null"> and instructor_name= #{instructorName}</if>
            <if test="semester != null"> and semester= #{semester}</if>
            <if test="school != null"> and school= #{school}</if>
        </where>
        order by Course.id desc
    </select>

    <select id="selectById" resultType="com.coursistant.individual.entity.Course">
        select
        <include refid="Base_Column_List" />
        from Course
        where id = #{id}
    </select>

    <delete id="deleteById">
        delete from Course
        where  id = #{id}
    </delete>

    <insert id="insert" parameterType="com.coursistant.individual.entity.Course" useGeneratedKeys="true">
        insert into Course
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="name != null">name,</if>
            <if test="courseCode != null">course_code,</if>
            <if test="teacherId != null">teacher_id,</if>
            <if test="instructorName != null">instructor_name,</if>
            <if test="semester != null">semester,</if>
            <if test="school != null">school,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="name != null">#{name},</if>
            <if test="courseCode != null">#{courseCode},</if>
            <if test="teacherId != null">#{teacherId},</if>
            <if test="instructorName != null">#{instructorName},</if>
            <if test="semester != null">#{semester},</if>
            <if test="school != null">#{school},</if>
        </trim>
    </insert>

    <update id="updateById" parameterType="com.coursistant.individual.entity.Course">
        update Course
        <set>
            <if test="name != null">
                name = #{name},
            </if>
            <if test="courseCode != null">
                course_code = #{courseCode},
            </if>
            <if test="teacherId != null">
                teacher_id = #{teacherId},
            </if>
            <if test="instructorName != null">
                instructor_name = #{instructorName},
            </if>
            <if test="semester != null">
                semester = #{semester},
            </if>
            <if test="school != null">
                school = #{school},
            </if>
        </set>
        where id = #{id}
    </update>


</mapper>