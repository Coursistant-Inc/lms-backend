<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coursistant.lms.mapper.interaction.FeedbackMapper">

    <sql id="Base_Column_List">
        id, user_id, course_id, content, date, level, current_url
    </sql>

    <!-- 查询所有 Feedback // Select all Feedback records -->
    <select id="selectAll" resultType="com.coursistant.lms.entity.Feedback">
        select
        <include refid="Base_Column_List"/>
        from Feedback
        <where>
            <if test="id != null"> and id = #{id}</if>
            <if test="userId != null"> and user_id = #{userId}</if>
            <if test="courseId != null"> and course_id = #{courseId}</if>
            <if test="content != null"> and content like concat('%', #{content}, '%')</if>
            <if test="date != null"> and date = #{date}</if>
            <if test="level != null"> and level = #{level}</if>
            <if test="currentUrl != null"> and current_url = #{currentUrl}</if>
        </where>
    </select>

    <!-- 通过 ID 查询 // Select Feedback by ID -->
    <select id="selectById" resultType="com.coursistant.lms.entity.Feedback">
        select
        <include refid="Base_Column_List"/>
        from Feedback
        where id = #{id}
    </select>

    <!-- 通过 ID 删除 // Delete Feedback by ID -->
    <delete id="deleteById">
        delete from Feedback where id = #{id}
    </delete>

    <!-- 插入新的 Feedback // Insert a new Feedback record -->
    <insert id="insert" parameterType="com.coursistant.lms.entity.Feedback" useGeneratedKeys="true" keyProperty="id">
        insert into Feedback
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="courseId != null">course_id,</if>
            <if test="content != null">content,</if>
            <if test="level != null">level,</if>
            <if test="currentUrl != null">current_url,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="courseId != null">#{courseId},</if>
            <if test="content != null">#{content},</if>
            <if test="level != null">#{level},</if>
            <if test="currentUrl != null">#{currentUrl},</if>
        </trim>
    </insert>

    <!-- 更新 Feedback // Update Feedback -->
    <update id="updateById" parameterType="com.coursistant.lms.entity.Feedback">
        update Feedback
        <set>
            <if test="userId != null">
                user_id = #{userId},
            </if>
            <if test="courseId != null">
                course_id = #{courseId},
            </if>
            <if test="content != null">
                content = #{content},
            </if>
            <if test="date != null">
                date = #{date},
            </if>
            <if test="level != null">
                level = #{level},
            </if>
            <if test="currentUrl != null">
                current_url = #{currentUrl},
            </if>
        </set>
        where id = #{id}
    </update>

</mapper>
