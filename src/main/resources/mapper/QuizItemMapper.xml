<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coursistant.lms.mapper.quiz.QuizItemMapper">

    <sql id="Base_Column_List">
        id, quiz_id, question_id, points, order_index, question_snapshot, updated_at
    </sql>

    <select id="selectAll" resultType="com.coursistant.lms.entity.QuizItem">
        select
        <include refid="Base_Column_List"/>
        from QuizItem
        <where>
            <if test="id != null">and id = #{id}</if>
            <if test="quizId != null">and quiz_id = #{quizId}</if>
            <if test="questionId != null">and question_id = #{questionId}</if>
            <if test="points != null">and points = #{points}</if>
            <if test="orderIndex != null">and order_index = #{orderIndex}</if>
            <if test="questionSnapshot != null">and question_snapshot = #{questionSnapshot}</if>
            <if test="updatedAt != null">and updated_at = #{updatedAt}</if>
        </where>
    </select>

    <select id="selectById" resultType="com.coursistant.lms.entity.QuizItem">
        select
        <include refid="Base_Column_List"/>
        from QuizItem
        where id = #{id}
    </select>

    <delete id="deleteById">
        delete from QuizItem where id = #{id}
    </delete>

    <insert id="insert" parameterType="com.coursistant.lms.entity.QuizItem" useGeneratedKeys="true" keyProperty="id">
        insert into QuizItem
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="quizId != null">quiz_id,</if>
            <if test="questionId != null">question_id,</if>
            <if test="points != null">points,</if>
            <if test="orderIndex != null">order_index,</if>
            <if test="questionSnapshot != null">question_snapshot,</if>
            <if test="updatedAt != null">updated_at,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="quizId != null">#{quizId},</if>
            <if test="questionId != null">#{questionId},</if>
            <if test="points != null">#{points},</if>
            <if test="orderIndex != null">#{orderIndex},</if>
            <if test="questionSnapshot != null">#{questionSnapshot},</if>
            <if test="updatedAt != null">#{updatedAt},</if>
        </trim>
    </insert>

    <update id="updateById" parameterType="com.coursistant.lms.entity.QuizItem">
        update QuizItem
        <set>
            <if test="quizId != null">quiz_id = #{quizId},</if>
            <if test="questionId != null">question_id = #{questionId},</if>
            <if test="points != null">points = #{points},</if>
            <if test="orderIndex != null">order_index = #{orderIndex},</if>
            <if test="questionSnapshot != null">question_snapshot = #{questionSnapshot},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
        </set>
        where id = #{id}
    </update>


    <select id="selectByQuestionId" resultType="com.coursistant.lms.entity.QuizItem">
        select
        <include refid="Base_Column_List"/>
        from QuizItem
        where question_id = #{questionId}
    </select>


    <select id="selectByQuizId" resultType="com.coursistant.lms.entity.QuizItem">
        select
        <include refid="Base_Column_List"/>
        from QuizItem
        where quiz_id = #{quizId}
    </select>



</mapper>
