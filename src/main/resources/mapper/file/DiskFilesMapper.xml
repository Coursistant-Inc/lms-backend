<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coursistant.lms.module.file.repository.DiskFilesMapper">

    <sql id="Base_Column_List">
        id,name,path,user_id,course_id,type,size,create_time,`delete`,category,summary
    </sql>


    <select id="selectAll" resultType="com.coursistant.lms.module.file.entity.DiskFiles">
        select
        <include refid="Base_Column_List" />
        from Diskfiles
        <where>
            <if test="name != null"> and name like concat('%', #{name}, '%')</if>
            <if test="path != null"> and path= #{path}</if>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="courseId != null">
                AND course_id = #{courseId}
            </if>
            <if test="type != null">
                AND type = #{type}
            </if>
            <if test="size != null">
                AND size = #{size}
            </if>
            <if test="createTime != null">
                AND create_time = #{createTime}
            </if>
            <if test="delete != null">
                AND `delete` = #{delete}
            </if>
            <if test="category != null">
                AND category = #{category}
            </if>
            <if test="summary != null">
                AND summary = #{summary}
            </if>
        </where>
        order by id desc
    </select>

    <select id="selectById" resultType="com.coursistant.lms.module.file.entity.DiskFiles">
        select
        <include refid="Base_Column_List" />
        from Diskfiles
        where id = #{id}
    </select>

    <delete id="deleteById">
        delete from Diskfiles
        where  id = #{id}
    </delete>

    <delete id="deleteBatch">
        delete from Diskfiles where user_id = #{userId} and `delete` = 1
    </delete>

    <insert id="insert" parameterType="com.coursistant.lms.module.file.entity.DiskFiles" useGeneratedKeys="true" keyProperty="id">
        insert into Diskfiles
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="name != null">name,</if>
            <if test="path != null">path,</if>
            <if test="userId != null">user_id,</if>
            <if test="type != null">type,</if>
            <if test="size != null">size,</if>
            <if test="createTime != null">create_time,</if>
            <if test="courseId != null">course_id,</if>
            <if test="category != null">category,</if>
            <if test="summary != null">summary,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="name != null">#{name},</if>
            <if test="path != null">#{path},</if>
            <if test="userId != null">#{userId},</if>
            <if test="type != null">#{type},</if>
            <if test="size != null">#{size},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="courseId != null">#{courseId},</if>
            <if test="category != null">#{category},</if>
            <if test="summary != null">#{summary},</if>
        </trim>
    </insert>

    <update id="updateById" parameterType="com.coursistant.lms.module.file.entity.DiskFiles">
        update Diskfiles
        <set>
            <if test="name != null">
                name = #{name},
            </if>
            <if test="path != null">
                path = #{path},
            </if>
            <if test="userId != null">
                user_id = #{userId},
            </if>
            <if test="type != null">
                type = #{type},
            </if>
            <if test="size != null">
                size = #{size},
            </if>
            <if test="createTime != null">
                create_time = #{createTime},
            </if>
            <if test="courseId != null">
                course_id = #{courseId},
            </if>
            <if test="delete != null">
                `delete` = #{delete},
            </if>
            <if test="category != null">
                category = #{category},
            </if>
            <if test="summary != null">
                summary = #{summary},
            </if>
        </set>
        where id = #{id}
    </update>

</mapper>