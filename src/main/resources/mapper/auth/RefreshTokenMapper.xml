<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.coursistant.lms.module.auth.token.repository.RefreshTokenMapper">

    <sql id="Base_Column_List">
        id,
        session_id AS sessionId,
        user_id AS userId,
        token,
        previous_token AS previousToken,
        previous_valid_until AS previousValidUntil,
        ip_address AS ipAddress,
        user_agent AS userAgent,
        expire_time AS expireTime,
        created_time AS createdTime,
        updated_time AS updatedTime,
        role
    </sql>

    <insert id="insert" parameterType="com.coursistant.lms.module.auth.token.entity.RefreshToken" useGeneratedKeys="true" keyProperty="id">
        insert into refresh_tokens
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="sessionId != null">session_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="token != null">token,</if>
            <if test="previousToken != null">previous_token,</if>
            <if test="previousValidUntil != null">previous_valid_until,</if>
            <if test="ipAddress != null">ip_address,</if>
            <if test="userAgent != null">user_agent,</if>
            <if test="expireTime != null">expire_time,</if>
            <if test="role != null">role,</if>
            created_time,
            updated_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="sessionId != null">#{sessionId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="token != null">#{token},</if>
            <if test="previousToken != null">#{previousToken},</if>
            <if test="previousValidUntil != null">#{previousValidUntil},</if>
            <if test="ipAddress != null">#{ipAddress},</if>
            <if test="userAgent != null">#{userAgent},</if>
            <if test="expireTime != null">#{expireTime},</if>
            <if test="role != null">#{role},</if>
            now(),
            now()
        </trim>
    </insert>

    <update id="updateById" parameterType="com.coursistant.lms.module.auth.token.entity.RefreshToken">
        update refresh_tokens
        <set>
            <if test="sessionId != null">session_id = #{sessionId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="token != null">token = #{token},</if>
            <if test="previousToken != null">previous_token = #{previousToken},</if>
            <if test="previousValidUntil != null">previous_valid_until = #{previousValidUntil},</if>
            <if test="ipAddress != null">ip_address = #{ipAddress},</if>
            <if test="userAgent != null">user_agent = #{userAgent},</if>
            <if test="expireTime != null">expire_time = #{expireTime},</if>
            <if test="role != null">role = #{role},</if>
            updated_time = now()
        </set>
        where id = #{id}
    </update>

    <select id="selectByUserIdAndRoleOrderByCreateTime" resultType="com.coursistant.lms.module.auth.token.entity.RefreshToken">
        SELECT
        <include refid="Base_Column_List"/>
        FROM refresh_tokens
        WHERE user_id = #{userId} AND role = #{role}
        ORDER BY created_time ASC
    </select>

    <delete id="deleteById">
        delete from refresh_tokens where id = #{id}
    </delete>

    <delete id="deleteByUserId">
        delete from refresh_tokens where user_id = #{userId}
    </delete>

    <delete id="deleteByToken">
        delete from refresh_tokens where token = #{token} OR previous_token = #{token}
    </delete>

    <delete id="deleteBySessionId">
        delete from refresh_tokens where session_id = #{sessionId}
    </delete>

    <delete id="deleteExpiredTokens">
        delete from refresh_tokens where expire_time &lt; now()
    </delete>

    <select id="selectById" resultType="com.coursistant.lms.module.auth.token.entity.RefreshToken">
        select
        <include refid="Base_Column_List" />
        from refresh_tokens
        where id = #{id}
    </select>

    <select id="selectByUserId" resultType="com.coursistant.lms.module.auth.token.entity.RefreshToken">
        select
        <include refid="Base_Column_List" />
        from refresh_tokens
        where user_id = #{userId}
        order by created_time desc
        limit 1
    </select>

    <select id="selectByToken" resultType="com.coursistant.lms.module.auth.token.entity.RefreshToken">
        select
        <include refid="Base_Column_List" />
        from refresh_tokens
        where token = #{token}
           or previous_token = #{token}
        limit 1
    </select>

    <select id="selectBySessionIdForUpdate" resultType="com.coursistant.lms.module.auth.token.entity.RefreshToken">
        select
        <include refid="Base_Column_List" />
        from refresh_tokens
        where session_id = #{sessionId}
        for update
    </select>

    <select id="selectAllByUserId" resultType="com.coursistant.lms.module.auth.token.entity.RefreshToken">
        select
        <include refid="Base_Column_List" />
        from refresh_tokens
        where user_id = #{userId}
        order by created_time desc
    </select>

</mapper>
