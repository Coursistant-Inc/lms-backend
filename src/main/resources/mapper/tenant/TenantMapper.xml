<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coursistant.lms.module.tenant.repository.TenantMapper">

    <sql id="Base_Column_List">
        id,
        name,
        timezone,
        status,
        security_version AS securityVersion,
        created_at AS createdAt,
        updated_at AS updatedAt
    </sql>

    <select id="selectById" resultType="com.coursistant.lms.module.tenant.entity.Tenant">
        SELECT
        <include refid="Base_Column_List"/>
        FROM tenant
        WHERE id = #{id}
    </select>

    <select id="selectByName" resultType="com.coursistant.lms.module.tenant.entity.Tenant">
        SELECT
        <include refid="Base_Column_List"/>
        FROM tenant
        WHERE name = #{name}
    </select>

    <select id="selectAllOrderByNameAsc" resultType="com.coursistant.lms.module.tenant.entity.Tenant">
        SELECT
        <include refid="Base_Column_List"/>
        FROM tenant
        ORDER BY name ASC, id ASC
    </select>

    <insert id="insert" parameterType="com.coursistant.lms.module.tenant.entity.Tenant"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tenant (name, timezone)
        VALUES (#{name}, #{timezone})
    </insert>

    <update id="updateById" parameterType="com.coursistant.lms.module.tenant.entity.Tenant">
        UPDATE tenant
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="timezone != null">timezone = #{timezone},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM tenant
        WHERE id = #{id}
    </delete>

</mapper>
