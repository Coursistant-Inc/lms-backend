<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coursistant.individual.mapper.file.SubmissionFileMapper">

    <sql id="Base_Column_List">
        id,submission_id,name,path
    </sql>

    <!-- 查询所有 SubmissionFile // Select all SubmissionFiles -->
    <select id="selectAll" resultType="com.coursistant.individual.entity.SubmissionFile">
        select
        <include refid="Base_Column_List" />
        from SubmissionFile
        <where>
            <if test="id != null"> and id = #{id}</if>
            <if test="submissionId != null"> and submission_id = #{submissionId}</if>
            <if test="name != null"> and name = #{name}</if>
            <if test="path != null"> and path = #{path}</if>
        </where>

    </select>

    <!-- 通过 ID 查询 SubmissionFile // Select SubmissionFile by ID -->
    <select id="selectById" resultType="com.coursistant.individual.entity.SubmissionFile">
        select
        <include refid="Base_Column_List" />
        from SubmissionFile
        where id = #{id}
    </select>

    <!-- 通过 ID 删除 SubmissionFile // Delete SubmissionFile by ID -->
    <delete id="deleteById">
        delete from SubmissionFile
        where id = #{id}
    </delete>

    <!-- 插入新的 SubmissionFile // Insert a new SubmissionFile -->
    <insert id="insert" parameterType="com.coursistant.individual.entity.SubmissionFile" useGeneratedKeys="true">
        insert into SubmissionFile
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="submissionId != null">submission_id,</if>
            <if test="name != null">name,</if>
            <if test="path != null">path,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="submissionId != null">#{submissionId},</if>
            <if test="name != null">name,</if>
            <if test="path != null">path,</if>
        </trim>
    </insert>


    <!-- 更新 SubmissionFile // Update SubmissionFile -->
    <update id="updateById" parameterType="com.coursistant.individual.entity.SubmissionFile">
        update SubmissionFile
        <set>
            <if test="submissionId != null">
                submission_id = #{submissionId},
            </if>
            <if test="name != null">
                name = #{name},
            </if>
            <if test="path != null">
                path = #{path},
            </if>
        </set>
        where id = #{id}
    </update>


</mapper>
