<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coursistant.lms.module.user.account.repository.UserMapper">

    <!-- Always alias snake_case -> camelCase to avoid relying on global underscoreToCamelCase -->
    <sql id="Base_Column_List">
        id,
        tenant_id AS tenantId,
        username,
        password,
        name,
        email,
        avatar,
        role,
        level,
        must_change_password AS mustChangePassword,
        email_notifications AS emailNotifications
    </sql>

    <!-- ====== SELECTS ====== -->
    <select id="selectAll" resultType="com.coursistant.lms.module.user.account.entity.User">
        SELECT
        <include refid="Base_Column_List"/>
        FROM user
        <where>
            <if test="id != null">AND id = #{id}</if>
            <if test="tenantId != null">AND tenant_id = #{tenantId}</if>
            <if test="username != null">AND username = #{username}</if>
            <if test="password != null">AND password = #{password}</if>
            <if test="name != null">AND name = #{name}</if>
            <if test="email != null">AND email = #{email}</if>
            <if test="avatar != null">AND avatar = #{avatar}</if>
            <if test="role != null">AND role = #{role}</if>
            <if test="level != null">AND level = #{level}</if>
            <if test="mustChangePassword != null">AND must_change_password = #{mustChangePassword, jdbcType=TINYINT}</if>
            <if test="emailNotifications != null">AND email_notifications = #{emailNotifications, jdbcType=TINYINT}</if>
        </where>
    </select>

    <select id="selectById" resultType="com.coursistant.lms.module.user.account.entity.User">
        SELECT
        <include refid="Base_Column_List"/>
        FROM user
        WHERE id = #{id}
    </select>


    <select id="selectStudentsByCourseId" resultType="com.coursistant.lms.module.user.account.entity.User">
        SELECT
        <include refid="Base_Column_List"/>
        FROM user
        WHERE 1 = 0
    </select>

    <select id="selectUsersByIds" resultType="com.coursistant.lms.module.user.account.entity.User">
        SELECT
        <include refid="Base_Column_List"/>
        FROM user
        WHERE id IN
        <foreach item="id" collection="userIds" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!-- ====== DML ====== -->

    <delete id="deleteById">
        DELETE FROM user
        WHERE id = #{id}
    </delete>

    <insert id="insert" parameterType="com.coursistant.lms.module.user.account.entity.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="tenantId != null">tenant_id,</if>
            <if test="username != null">username,</if>
            <if test="password != null">password,</if>
            <if test="name != null">name,</if>
            <if test="email != null">email,</if>
            <if test="avatar != null">avatar,</if>
            <if test="role != null">role,</if>
            <if test="level != null">level,</if>
            <if test="mustChangePassword != null">must_change_password,</if>
            <if test="emailNotifications != null">email_notifications,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="tenantId != null">#{tenantId},</if>
            <if test="username != null">#{username},</if>
            <if test="password != null">#{password},</if>
            <if test="name != null">#{name},</if>
            <if test="email != null">#{email},</if>
            <if test="avatar != null">#{avatar},</if>
            <if test="role != null">#{role},</if>
            <if test="level != null">#{level},</if>
            <if test="mustChangePassword != null">#{mustChangePassword, jdbcType=TINYINT},</if>
            <if test="emailNotifications != null">#{emailNotifications, jdbcType=TINYINT},</if>
        </trim>
    </insert>

    <!-- tenant_id is intentionally excluded — only updateTenantId may change it -->
    <update id="updateById" parameterType="com.coursistant.lms.module.user.account.entity.User">
        UPDATE user
        <set>
            <if test="username != null">username = #{username},</if>
            <if test="password != null">password = #{password},</if>
            <if test="name != null">name = #{name},</if>
            <if test="email != null">email = #{email},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="role != null">role = #{role},</if>
            <if test="level != null">level = #{level},</if>
            <if test="mustChangePassword != null">
                must_change_password = #{mustChangePassword, jdbcType=TINYINT},
            </if>
            <if test="emailNotifications != null">
                email_notifications = #{emailNotifications, jdbcType=TINYINT},
            </if>
        </set>
        WHERE id = #{id}
    </update>

    <update id="updateTenantId">
        UPDATE user
        SET tenant_id = #{tenantId}
        WHERE id = #{id}
    </update>

    <update id="updateMustChangePassword">
        UPDATE user
        SET must_change_password = #{mustChangePassword, jdbcType=TINYINT}
        WHERE id = #{id}
    </update>

    <update id="clearAvatar">
        UPDATE user
        SET avatar = NULL
        WHERE id = #{id}
    </update>

    <select id="selectUserLevelById" parameterType="com.coursistant.lms.module.user.account.entity.User" resultType="String">
        SELECT level 
        FROM user 
        WHERE id = #{userId}
    </select>

</mapper>
