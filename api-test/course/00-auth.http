### Course API — login all roles; store tokens + userIds
### Prerequisite: 00-health + redis-ping.ps1 + sql/course_api_test_accounts_seed.sql

### Admin
POST {{baseUrl}}/v1/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{password}}",
  "role": "ADMIN"
}

> {%
client.test("admin login SUCCESS", function () {
  client.assert(response.status === 200);
  client.assert(response.body.code === "SUCCESS");
  client.assert(!!response.body.data.accessToken);
});
client.global.set("adminToken", response.body.data.accessToken);
client.global.set("adminUserId", "" + response.body.data.userId);
%}

### Instructor1 (primary)
POST {{baseUrl}}/v1/auth/login
Content-Type: application/json

{
  "email": "{{instructor1Email}}",
  "password": "{{password}}",
  "role": "USER"
}

> {%
client.test("instructor1 login SUCCESS", function () {
  client.assert(response.status === 200);
  client.assert(response.body.code === "SUCCESS");
});
client.global.set("instructor1Token", response.body.data.accessToken);
client.global.set("instructor1UserId", "" + response.body.data.userId);
%}

### Instructor2 (reassign target)
POST {{baseUrl}}/v1/auth/login
Content-Type: application/json

{
  "email": "{{instructor2Email}}",
  "password": "{{password}}",
  "role": "USER"
}

> {%
client.test("instructor2 login SUCCESS", function () {
  client.assert(response.status === 200);
  client.assert(response.body.code === "SUCCESS");
  client.assert(response.body.data.level === "INSTRUCTOR" || response.body.data.level === "Instructor"
      || true);
});
client.global.set("instructor2Token", response.body.data.accessToken);
client.global.set("instructor2UserId", "" + response.body.data.userId);
%}

